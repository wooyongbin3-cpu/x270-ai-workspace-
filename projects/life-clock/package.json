{
  "name": "life-clock",
  "version": "1.2.0",
  "private": true,
  "description": "生命时钟 · 本地单页，设置缓存，精美生命时长展示",
  "scripts": {
    "dev": "python -m http.server 8000",
    "build": "node scripts/build.mjs",
    "sync": "node scripts/build.mjs && npx cap sync android",
    "android": "npx cap open android",
    "test": "node tests/verify.mjs && node tests/build-check.mjs",
    "test:browser": "node tests/browser-smoke.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
